<?xml version="1.0" encoding="utf-8"?>
<!--
  Excludes app storage from cloud backup and device-to-device transfer.
  Capacitor Preferences (SharedPreferences) holds the Supabase session token,
  so it must never leave the device through a backup.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" />
        <exclude domain="database" />
        <exclude domain="file" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" />
        <exclude domain="database" />
        <exclude domain="file" />
    </device-transfer>
</data-extraction-rules>
